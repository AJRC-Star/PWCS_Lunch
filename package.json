{
  "name": "chs-lunch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run generate-icons && tsc && vite build",
    "test": "vitest run",
    "test:local-fetch": "bash scripts/local-fetch.test.sh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "validate:artifact": "npx tsx scripts/validate-menu-artifact.ts",
    "check:artifact-freshness": "npx tsx scripts/check-artifact-freshness.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.0.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.8"
  }
}
